//==================================================================
// ── DYNAMIC EXPANSION ─────────────────────────────────────────────
//==================================================================
bool ExpandUp()
{
   long ch = ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
   if (ch > 0 && g_oy < ch / 2) return false;
   return true;
}

//==================================================================
// ── GEOMETRY ──────────────────────────────────────────────────────
//==================================================================
int HdrY()            { return g_oy; }
int ContentY(int r=0) { return (ExpandUp() ? g_oy-CONTENT_H : g_oy+HDR_H)+r; }
int PnlTopY()         { return (ExpandUp() && !g_col) ? g_oy-CONTENT_H : g_oy; }
int PnlBotY()         { return (!ExpandUp() && !g_col) ? g_oy+HDR_H+CONTENT_H : g_oy+HDR_H; }

