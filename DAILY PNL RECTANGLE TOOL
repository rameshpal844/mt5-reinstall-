// ── OnInit ────────────────────────────────────────────────────────
//==================================================================
int OnInit()
{
   ChartSetInteger(0,CHART_EVENT_OBJECT_CREATE,true);
   ChartSetInteger(0,CHART_EVENT_OBJECT_DELETE,true);
   ChartSetInteger(0,CHART_EVENT_MOUSE_MOVE,   true);

   if(!InpShowPanel)
   {
       ObjectsDeleteAll(0,g_pfx);
       ObjectDelete(0,HDR_RECT_BTN);
       ObjectDelete(0,HDR_TOGGLE_BTN);
       ChartRedraw(0);
       return INIT_SUCCEEDED;
   }

   g_currentSnap = InpDefaultPos;
   int savedSetting=-1;
   if(GlobalVariableCheck(GV_SET)) savedSetting=(int)GlobalVariableGet(GV_SET);
   
   if(savedSetting > 0 && savedSetting <= 4) g_currentSnap = (ENUM_DEFAULT_POS)savedSetting;

   if(GlobalVariableCheck(GV_X) && GlobalVariableCheck(GV_Y))
   {
      g_ox=(int)GlobalVariableGet(GV_X);
      g_oy=(int)GlobalVariableGet(GV_Y);
      g_autoPositioned=true;
      g_wasManuallyDragged=true;
   }
   else
   {
      g_autoPositioned=false;
      g_wasManuallyDragged=false;
   }
   GlobalVariableSet(GV_SET,(int)g_currentSnap);

   if(GlobalVariableCheck(GV_COLOR))
      g_currentZoneColor=(color)GlobalVariableGet(GV_COLOR);

   g_col=true; g_rebuild=true;
   UpdateDayBal(); Draw(); EventSetTimer(1);
   ChartRedraw(0);
   return INIT_SUCCEEDED;
}

//==================================================================
// ── OnDeinit ──────────────────────────────────────────────────────
//==================================================================
void OnDeinit(const int reason)
{
   EventKillTimer();
   ChartSetInteger(0,CHART_EVENT_MOUSE_MOVE,false);

   if(g_wasManuallyDragged && InpShowPanel)
   {
      GlobalVariableSet(GV_X,g_ox);
      GlobalVariableSet(GV_Y,g_oy);
   }
   else if (InpShowPanel)
   {
      if(GlobalVariableCheck(GV_X)) GlobalVariableDel(GV_X);
      if(GlobalVariableCheck(GV_Y)) GlobalVariableDel(GV_Y);
   }

   if(InpShowPanel)
   {
      ObjectsDeleteAll(0,g_pfx);
      ObjectDelete(0,HDR_RECT_BTN);
      ObjectDelete(0,HDR_TOGGLE_BTN);
   }
   ChartRedraw(0);
}

//==================================================================
// ── OnCalculate ───────────────────────────────────────────────────
//==================================================================
int OnCalculate(const int rates_total,const int prev_calculated,
                const datetime &time[],const double &open[],
                const double &high[],const double &low[],const double &close[],
                const long &tick_volume[],const long &volume[],const int &spread[])
{
   if(InpShowPanel) ChartRedraw(0);
   return rates_total;
}

//==================================================================
// ── OnTimer ───────────────────────────────────────────────────────
//==================================================================
void OnTimer()
{
   if(!InpShowPanel) return;

   if(!g_autoPositioned)
   {
      ApplyAutoPos();
      if(g_autoPositioned){ g_rebuild=true; Draw(); ChartRedraw(0); return; }
   }
   UpdateDayBal(); Draw(); ChartRedraw(0);
}

//==================================================================
// ── OnChartEvent ─────────────────────────────────────────────────
//==================================================================
void OnChartEvent(const int id,const long &lp,const double &dp,const string &sp)
{
   int x=(int)lp, y=(int)dp;

   // Color memory — save when user edits a zone
   if(id==CHARTEVENT_OBJECT_CHANGE)
   {
      if(StringFind(sp,"ZoneRect_")==0)
      {
         g_currentZoneColor=(color)ObjectGetInteger(0,sp,OBJPROP_COLOR);
         GlobalVariableSet(GV_COLOR,(double)g_currentZoneColor);
      }
   }

   if(!InpShowPanel) return; // Ignore interface clicks/drags if hidden

   // ESC — cancel drawing
   if(id==CHARTEVENT_KEYDOWN && lp==27)
   {
      if(isDrawing)
      {
         if(clickStep==1) ObjectDelete(0,currentObjName);
         isDrawing=false; clickStep=0;
         if(ObjectFind(0,HDR_RECT_BTN)>=0)
         {
            ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_BGCOLOR,InpHdrBg);
            ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_COLOR,  clrWhite);
         }
         ChartRedraw(0);
      }
      return;
   }

   // H key — toggle PnL rows
   if(id==CHARTEVENT_KEYDOWN && lp==72)
   {
      g_col=!g_col; g_rebuild=true;
      Draw(); ChartRedraw(0); return;
   }

   // Object click
   if(id==CHARTEVENT_OBJECT_CLICK)
   {
      // Toggle Instant Snap (Upper vs Lower Right) using the floating triangle
      if(sp==HDR_TOGGLE_BTN)
      {
         long ch = ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
         
         if(g_oy > ch/2) g_currentSnap = POS_UPPER_RIGHT;
         else            g_currentSnap = POS_LOWER_RIGHT;
         
         g_wasManuallyDragged = false;
         ApplyAutoPos();
         
         GlobalVariableSet(GV_SET, (int)g_currentSnap);
         if(GlobalVariableCheck(GV_X)) GlobalVariableDel(GV_X);
         if(GlobalVariableCheck(GV_Y)) GlobalVariableDel(GV_Y);
         
         g_rebuild = true; Draw(); ChartRedraw(0); return;
      }
      
      // Toggle Rect Tool
      if(sp==HDR_RECT_BTN)
      {
         isDrawing=!isDrawing; clickStep=0;
         ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_STATE, false);
         ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_BGCOLOR,isDrawing?CLR_BTN_ACTIVE:InpHdrBg);
         ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_COLOR,  clrWhite);
         ChartRedraw(0); return;
      }
   }

   // Mouse move — drag + live preview
   if(id==CHARTEVENT_MOUSE_MOVE)
   {
      bool held=(StringFind(sp,"1")>=0);
      int mx=x, my=y;

      if(!held)
      {
         if(g_drag)
         {
            g_drag=false;
            g_wasManuallyDragged=true;
            GlobalVariableSet(GV_X,g_ox);
            GlobalVariableSet(GV_Y,g_oy);
            g_rebuild=true; Draw(); ChartRedraw(0);
         }
         else if(g_mouseOnHdr)
         {
            int dx=MathAbs(mx-g_clickX), dy=MathAbs(my-g_clickY);
            // Don't collapse if clicking near the Rect tool
            bool onActionBtns=(g_clickX>=g_ox+PW-30 && g_clickX<=g_ox+PW);
            if(dx<6 && dy<6 && !onActionBtns)
            {
               g_col=!g_col; g_rebuild=true;
               Draw(); ChartRedraw(0);
            }
         }
         g_mouseOnHdr=false;
         return;
      }

      bool onHdr=(mx>=g_ox && mx<=g_ox+PW && my>=HdrY() && my<=HdrY()+HDR_H);

      if(!g_drag && !g_mouseOnHdr && onHdr)
      {
         g_mouseOnHdr=true; g_clickX=mx; g_clickY=my;
         g_dDX=mx-g_ox; g_dDY=my-HdrY();
      }
      if(g_mouseOnHdr && !g_drag)
         if(MathAbs(mx-g_clickX)>4 || MathAbs(my-g_clickY)>4) g_drag=true;

      if(g_drag)
      {
         int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);
         int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
         g_ox=MathMax(0,MathMin(mx-g_dDX,cw-PW));
         int ny=my-g_dDY;
         int topOffset=g_oy-PnlTopY();
         int botOffset=PnlBotY()-g_oy;
         ny=MathMax(topOffset,MathMin(ny,ch-botOffset));
         g_oy=ny;
         Reposition(); ChartRedraw(0);
      }

      // Live rect preview
      if(isDrawing && clickStep==1)
      {
         datetime t; double p; int w;
         if(ChartXYToTimePrice(0,x,y,w,t,p))
         {
            ObjectSetDouble (0,currentObjName,OBJPROP_PRICE,1,p);
            datetime futureTime=TimeCurrent()+86400*365*10;
            ObjectSetInteger(0,currentObjName,OBJPROP_TIME,1,futureTime);
            ChartRedraw(0);
         }
      }
      return;
   }

   // Chart change (Resizing handling)
   if(id==CHARTEVENT_CHART_CHANGE)
   {
      int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);
      int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
      
      if(cw>0 && ch>0)
      {
         if(!g_wasManuallyDragged)
         {
            ApplyAutoPos();
         }
         else
         {
            // Boundary constraints keep the panel visible if the chart shrinks
            if(g_ox + PW > cw) g_ox = (int)MathMax(0, cw - PW - 6);
            if(g_oy + HDR_H > ch) g_oy = (int)MathMax(0, ch - HDR_H - 2);
            if(g_ox < 0) g_ox = 6;
            if(g_oy < 0) g_oy = 6;
         }
      }
      
      if(!g_autoPositioned){ ApplyAutoPos(); Draw(); ChartRedraw(0); return; }
      Reposition(); ChartRedraw(0);
   }

   // Chart click — draw zone
   if(id==CHARTEVENT_CLICK && isDrawing && !g_drag)
   {
      if(GetTickCount()-lastClickTime<200) return;
      lastClickTime=GetTickCount();

      int panelTop=PnlTopY(), panelBot=PnlBotY();
      if(x>=g_ox && x<=g_ox+PW && y>=panelTop && y<=panelBot) return;

      datetime t; double p; int w;
      if(ChartXYToTimePrice(0,x,y,w,t,p))
      {
         if(clickStep==0)
         {
            startX=x; startY=y; startPrice=p; startTime=t;
            currentObjName="ZoneRect_"+IntegerToString(GetTickCount());
            datetime futureTime=TimeCurrent()+86400*365*10;

            ObjectCreate(0,currentObjName,OBJ_RECTANGLE,0,startTime,startPrice,futureTime,startPrice);
            ObjectSetInteger(0,currentObjName,OBJPROP_COLOR,      g_currentZoneColor);
            ObjectSetInteger(0,currentObjName,OBJPROP_FILL,       true);
            ObjectSetInteger(0,currentObjName,OBJPROP_BACK,       true);
            ObjectSetInteger(0,currentObjName,OBJPROP_SELECTABLE, true);
            ObjectSetInteger(0,currentObjName,OBJPROP_SELECTED,   true);
            ObjectSetInteger(0,currentObjName,OBJPROP_HIDDEN,     false);
            ObjectSetInteger(0,currentObjName,OBJPROP_TIMEFRAMES, OBJ_ALL_PERIODS);
            clickStep=1;
         }
         else if(clickStep==1)
         {
            if(MathAbs(x-startX)<5 && MathAbs(y-startY)<5) return;
            datetime futureTime=TimeCurrent()+86400*365*10;
            ObjectSetInteger(0,currentObjName,OBJPROP_TIME,1,futureTime);
            ObjectSetDouble (0,currentObjName,OBJPROP_PRICE,1,p);
            ObjectSetInteger(0,currentObjName,OBJPROP_SELECTED,true);

            isDrawing=false; clickStep=0;
            if(ObjectFind(0,HDR_RECT_BTN)>=0)
            {
               ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_BGCOLOR,InpHdrBg);
               ObjectSetInteger(0,HDR_RECT_BTN,OBJPROP_COLOR,  clrWhite);
            }
         }
         ChartRedraw(0);
      }
   }
}
