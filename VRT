void SetLabel(ulong ticket, const string id, double price, string sideStr, string lotStr,
              string valStr, color sideCol, color valCol,
              color bgCol, color borderCol, color dimCol, color sepCol,
              string subText, color subTextCol, bool beActive, int zBase)
{
   int px,py;
   if(!ChartTimePriceToXY(0,0,iTime(_Symbol,_Period,0),price,px,py)) return;
   string sfx = IntegerToString((int)ticket);
   
   int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);
   int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
   int W = g_dyn_W;
   int H = g_dyn_H;
   int T = Border_Thickness;
   
   bool isEntry = (StringGetCharacter(id,0)=='E');
   
   int menu_w = 0;
   if(isEntry) {
      if(PanelStyle == PANEL_1_CLASSIC) menu_w = (H + 4) * 3;
      else menu_w = H + 2; 
   }
   int close_w = H + 2;
   int full_w = menu_w + W + close_w;
   
   int sub_h = (int)(15 * g_ui_scale);
   int full_h = H + (subText != "" ? sub_h : 0);
   
   int test_bx = cw - (int)(Label_FromRight * g_ui_scale);
   
   int right_margin = 15; 
   if(test_bx + W + close_w > cw - right_margin) {
       test_bx = cw - right_margin - W - close_w;
   }
   if(test_bx - menu_w < 10) test_bx = 10 + menu_w;

   int test_by = MathMax(T+1, MathMin(ch - full_h - T - 1, py - H/2));

   bool collision = true;
   int iter = 0;
   while(collision && iter < 30) {
       collision = false;
       for(int i=0; i<ArraySize(g_layout_rects); i++) {
           if(test_by < g_layout_rects[i].bottom + 2 && test_by + full_h > g_layout_rects[i].top - 2) {
              collision = true;
              
              int center_existing = (g_layout_rects[i].top + g_layout_rects[i].bottom) / 2;
              int center_new = test_by + full_h / 2;
              
              if(center_new >= center_existing) {
                  test_by = g_layout_rects[i].bottom + 2; 
              } else {
                  test_by = g_layout_rects[i].top - full_h - 2; 
              }
              break;
           }
       }
       iter++;
   }

   test_by = MathMax(T+1, MathMin(ch - full_h - T - 1, test_by));

   int sz = ArraySize(g_layout_rects);
   ArrayResize(g_layout_rects, sz+1);
   g_layout_rects[sz].left = test_bx - menu_w;
   g_layout_rects[sz].right = test_bx + W + close_w;
   g_layout_rects[sz].top = test_by;
   g_layout_rects[sz].bottom = test_by + full_h;

   int bx = test_bx;
   int by = test_by;

   int tY=by+H/2-g_dyn_Font/2-1;
   int cw0=(int)(g_dyn_Font*0.68);

   SetRect(PREFIX+"BX_"+id,bx,by,W,H,bgCol,borderCol,T,zBase);
   int x1=bx+T+6;
   SetText(PREFIX+"SD_"+id,x1,tY,sideStr,sideCol,-1,zBase);
   
   int x2=x1+(int)(StringLen(sideStr)*cw0)+4;
   SetText(PREFIX+"S1_"+id,x2,tY,"|",sepCol,-1,zBase);
   
   int x3=x2+cw0+4;
   SetText(PREFIX+"LT_"+id,x3,tY,ShowLotSize?lotStr:"",dimCol,-1,zBase);
   
   int lotW=ShowLotSize?(int)(StringLen(lotStr)*cw0)+4:0;
   int x4=x3+lotW;
   SetText(PREFIX+"S2_"+id,x4,tY,"|",sepCol,-1,zBase);
   
   int x5=x4+cw0+4;
   SetText(PREFIX+"VL_"+id,x5,tY,valStr,valCol,-1,zBase);

   if(subText!="") {
      int subFont = g_dyn_Font - 1;
      if (subFont < 6) subFont = 6;
      SetText(PREFIX+"SUB_"+id,bx,by+H+2,subText,subTextCol,subFont,zBase);
   }
   else SafeDelete(PREFIX+"SUB_"+id);

   int closeBtnX = bx + W + 2;
   
   if (isEntry) {
      if(PanelStyle == PANEL_1_CLASSIC) {
          int leftBtnX = bx;
          
          leftBtnX -= (H+4);
          SetBtn(PREFIX+"BTN_M_"+sfx, leftBtnX, by, H, H, "▼", c_Menu_BG, c_Menu_TC, "Partial Close Menu", zBase);
          SetPartialMenu_Classic(ticket, leftBtnX, by, H, zBase);
          
          leftBtnX -= (H+4);
          color beBg  = beActive ? C'230,155,55' : c_BE_Inact_BG;
          color beTc  = beActive ? clrWhite      : c_BE_Inact_TC;
          SetBtn(PREFIX+"BTN_B_"+sfx, leftBtnX, by, H, H, "BE", beBg, beTc, "Move SL to Breakeven", zBase);
          
          leftBtnX -= (H+4);
          SetBtn(PREFIX+"BTN_R_"+sfx, leftBtnX, by, H, H, "RR", C'51,122,183', clrWhite, "Risk:Reward Targets", zBase);
          SetRRMenu_Classic(ticket, leftBtnX, by, H, zBase);
          
      } else {
          int menuBtnX = bx - H - 2;
          SetBtn(PREFIX+"BTN_M_"+sfx, menuBtnX, by, H, H, "⚙\xFE0E", c_Gear_BG, c_Gear_TC, "Context Menu", zBase, true);
          // Pass the base 'by' to the context menu, let it handle up/down placement
          SetContextMenu_Gear(ticket, menuBtnX, by, full_w, H, beActive, zBase);
      }
      SetBtn(PREFIX+"BTN_E_"+sfx, closeBtnX, by, H, H, "X", C'200,60,60', clrWhite, "Close Position", zBase);
   } else {
      string act = StringSubstr(id,0,1);
      SetBtn(PREFIX+"BTN_"+act+"_"+sfx, closeBtnX, by, H, H, "X", C'200,60,60', clrWhite, "Remove", zBase);
   }
}

