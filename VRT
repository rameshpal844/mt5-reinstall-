void UpdateCandleTimer()
{
   if(!ShowCandleTimer) { SafeDelete(PREFIX+"TIMER"); return; }
   UpdateScale(); 
   
   datetime tOpen = iTime(_Symbol, _Period, 0);
   int remaining = (int)(tOpen + PeriodSeconds(_Period) - TimeCurrent());
   double current_price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   string txt = "";
   if(remaining < 0) txt = "0:00(-)"; 
   else {
      int h = remaining / 3600;
      int m = (remaining % 3600) / 60;
      int s = remaining % 60;
      
      if(h > 0) txt = IntegerToString(h) + ":" + (m < 10 ? "0" : "") + IntegerToString(m) + ":" + (s < 10 ? "0" : "") + IntegerToString(s);
      else txt = IntegerToString(m) + ":" + (s < 10 ? "0" : "") + IntegerToString(s);
   }

   string name = PREFIX+"TIMER";
   if(ObjectFind(0, name) < 0) {
      ObjectCreate(0, name, OBJ_TEXT, 0, 0, 0);
      ObjectSetString(0, name, OBJPROP_FONT, FontFace + " Bold");
      ObjectSetInteger(0, name, OBJPROP_BACK, false);
      ObjectSetInteger(0, name, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, name, OBJPROP_HIDDEN, true);
      ObjectSetInteger(0, name, OBJPROP_ZORDER, 100);
   }
   
   ObjectSetInteger(0, name, OBJPROP_FONTSIZE, g_dyn_Font);
   ObjectSetInteger(0, name, OBJPROP_ANCHOR, ANCHOR_LEFT_UPPER);
   ObjectSetInteger(0, name, OBJPROP_TIME, 0, tOpen);
   ObjectSetDouble(0, name, OBJPROP_PRICE, 0, current_price);
   
   ObjectSetString(0, name, OBJPROP_TEXT, "   " + txt);
   ObjectSetInteger(0, name, OBJPROP_COLOR, (remaining <= 10 ? clrRed : (ChartTheme == THEME_DARK ? clrWhite : clrBlack)));
}

