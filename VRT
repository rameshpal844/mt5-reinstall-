      ObjectSetInteger(0,n,OBJPROP_WIDTH, 1);
      ObjectSetInteger(0,n,OBJPROP_ZORDER, 5); 
      ObjectSetInteger(0,n,OBJPROP_HIDDEN, true); 
      ObjectSetInteger(0,n,OBJPROP_BACK, false);
      ObjectSetString(0,n,OBJPROP_TOOLTIP,"\n");
   }
   
   if(!hit && !(g_ptp_dragging && g_ptp_drag_idx == pt_idx && g_ptp_drag_tkt == (ulong)StringToInteger(sfx))) {
      ObjectSetDouble(0,n,OBJPROP_PRICE,0,price);
   } 
   
   ObjectSetInteger(0,n,OBJPROP_COLOR,col); 
   UpdatePTP_Labels(pt_idx, sfx, ObjectGetDouble(0,n,OBJPROP_PRICE,0), pct, hit);
}

