void SetZone(const string id, datetime t1, datetime t2, double p1, double p2, color bgCol)
{
   if(!ShowZones || MathAbs(p1 - p2) <= 0.000001) { SafeDelete(PREFIX+"ZN_"+id); return; } 
   string n = PREFIX+"ZN_"+id;
   
   if(ObjectCreate(0,n,OBJ_RECTANGLE,0,0,0,0,0)) {
      ObjectSetInteger(0,n,OBJPROP_BACK,true);
      ObjectSetInteger(0,n,OBJPROP_HIDDEN,true);
      ObjectSetInteger(0,n,OBJPROP_SELECTABLE,false);
      ObjectSetInteger(0,n,OBJPROP_FILL,true);
      ObjectSetString(0,n,OBJPROP_TOOLTIP,"\n");
   }
   
   ObjectSetInteger(0,n,OBJPROP_TIME,0,t1);
   ObjectSetInteger(0,n,OBJPROP_TIME,1,t2);
   ObjectSetDouble(0,n,OBJPROP_PRICE,0,p1);
   ObjectSetDouble(0,n,OBJPROP_PRICE,1,p2);
   ObjectSetInteger(0,n,OBJPROP_COLOR,bgCol);
   ObjectSetInteger(0,n,OBJPROP_ZORDER,0);
}

