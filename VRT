void UpdateScale() {
   int cw = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   if (cw < 750) {
      g_ui_scale = (double)cw / 750.0;
      if (g_ui_scale < 0.85) g_ui_scale = 0.85; 
   } else {
      g_ui_scale = 1.0;
   }
   
   g_dyn_W = (int)MathRound(Label_Width * g_ui_scale);
   g_dyn_H = (int)MathRound(Label_Height * g_ui_scale);
   g_dyn_Font = (int)MathRound(FontSize * g_ui_scale);
   if(g_dyn_Font < 8) g_dyn_Font = 8;
}

