void SetContextMenu_Gear(ulong ticket, int x, int y, int w, int h, bool beActive, int zBase) 
{
   string sfx = IntegerToString((int)ticket);
   string bB = PREFIX+"BTN_B_"+sfx;
   string bR = PREFIX+"BTN_R_"+sfx;
   string bP = PREFIX+"BTN_P_"+sfx;
   string bA = PREFIX+"ADDPTP_"+sfx; 

   if(ticket != g_active_menu_ticket) {
      SafeDelete(bR); SafeDelete(bB); SafeDelete(bP); SafeDelete(bA);
      SetRRMenu_Gear(ticket, 0, 0, 0, 0, false); 
      SetPartialMenu_Gear(ticket, 0, 0, 0, 0, false);
      return;
   }

   int m_h = h;
   
   // --- SMART UP/DOWN LOGIC ---
   bool up = false;
   long sl_y = ObjectGetInteger(0, PREFIX+"BX_S"+sfx, OBJPROP_YDISTANCE);
   long tp_y = ObjectGetInteger(0, PREFIX+"BX_T"+sfx, OBJPROP_YDISTANCE);
   int ch = (int)ChartGetInteger(0, CHART_HEIGHT_IN_PIXELS);
   int needed = m_h * 5; 
   
   if(sl_y > 0 && sl_y > y && (sl_y - y) < needed) up = true;
   if(tp_y > 0 && tp_y > y && (tp_y - y) < needed) up = true;
   if(y + m_h + 2 + needed > ch) up = true;
   
   int menu_y = up ? (y - m_h - 2) : (y + m_h + 2);

   int gap = 2; 
   int sbw = (w - gap*3) / 4; 
   int bx = x;
   
   // 1. BE
   color beBg = beActive ? C'230,155,55' : c_BE_Inact_BG;
   color beTc = beActive ? clrWhite : c_BE_Inact_TC;
   SetBtn(bB, bx, menu_y, sbw, m_h, "BE", beBg, beTc, "Move SL to Entry", zBase+10);
   bx += sbw + gap;
   
   // 2. RR
   string rr_arrow = up ? "RR ▴" : "RR ▾";
   SetBtn(bR, bx, menu_y, sbw, m_h, rr_arrow, c_Menu_BG, c_Menu_TC, "Set Risk:Reward", zBase+10);
   int rr_x = bx;
   bx += sbw + gap;
   
   // 3. PC
   string pc_arrow = up ? "PC ▴" : "PC ▾";
   SetBtn(bP, bx, menu_y, sbw, m_h, pc_arrow, c_Menu_BG, c_Menu_TC, "Partial Close", zBase+10);
   int pc_x = bx;
   bx += sbw + gap;
   
   // 4. +TP
   int last_w = w - (bx - x); 
   SetBtn(bA, bx, menu_y, last_w, m_h, "+TP", C'46,170,95', clrWhite, "Add Draggable Target", zBase+10);

   AddClickRect(x, x + w, menu_y, menu_y + m_h);

   if(g_active_rr_ticket == ticket) {
       SetRRMenu_Gear(ticket, rr_x, menu_y, m_h, zBase+15, up);
   } else {
       SetRRMenu_Gear(ticket, 0,0,0,0, false);
   }

   if(g_active_partial_ticket == ticket) {
       SetPartialMenu_Gear(ticket, pc_x, menu_y, m_h, zBase+15, up);
   } else {
       SetPartialMenu_Gear(ticket, 0,0,0,0, false);
   }
}

