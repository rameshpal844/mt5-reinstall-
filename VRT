void RefreshBoxes()
{
   UpdateScale(); 
   ApplyTheme();

   ArrayResize(g_layout_rects,0); 
   ArrayResize(g_click_rects,0); 
   
   double safe_point = (_Point > 0) ? _Point : 0.00001;

   PosData aPos[]; 
   int aCnt = 0;
   
   for(int i=0; i<PositionsTotal(); i++){
      ulong t = PositionGetTicket(i);
      if(t>0 && PositionGetString(POSITION_SYMBOL)==_Symbol){
         ArrayResize(aPos, aCnt+1);
         aPos[aCnt].tkt = t;
         aPos[aCnt].tm = (datetime)PositionGetInteger(POSITION_TIME);
         aCnt++;
      }
   }
   
   for(int i=0; i<aCnt-1; i++){
      for(int j=i+1; j<aCnt; j++){
         if(aPos[j].tm < aPos[i].tm){
            PosData tmp = aPos[i]; aPos[i] = aPos[j]; aPos[j] = tmp;
         }
      }
   }

   string activeTickets[];
   ArrayResize(activeTickets,aCnt);
   for(int a=0; a<aCnt; a++) activeTickets[a] = IntegerToString((int)aPos[a].tkt);

   if(aCnt==0){ 
      DeleteAll(); ArrayResize(g_drawn_tickets,0); 
      g_active_menu_ticket=0; g_active_rr_ticket=0; g_active_partial_ticket=0; return; 
   }

   for(int k=0; k<ArraySize(g_drawn_tickets); k++){
      bool found=false;
      for(int a=0; a<aCnt; a++) {
         if(g_drawn_tickets[k] == activeTickets[a]) { found=true; break; }
      }
      if(!found){
         if((ulong)StringToInteger(g_drawn_tickets[k]) == g_active_menu_ticket) g_active_menu_ticket = 0;
         if((ulong)StringToInteger(g_drawn_tickets[k]) == g_active_rr_ticket) g_active_rr_ticket = 0;
         if((ulong)StringToInteger(g_drawn_tickets[k]) == g_active_partial_ticket) g_active_partial_ticket = 0;
         DeleteTicketObjects(g_drawn_tickets[k]);
      }
   }
   
   ArrayResize(g_drawn_tickets,aCnt);
   for(int a=0; a<aCnt; a++) g_drawn_tickets[a] = activeTickets[a];

   int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);
   
   // --- PERFECT ZONE ALIGNMENT (No Gap) ---
   int menu_w = (PanelStyle == PANEL_1_CLASSIC) ? (g_dyn_H + 4) * 3 : (g_dyn_H + 2);
   int close_w = g_dyn_H + 2;
   
   int test_bx = cw - (int)(Label_FromRight * g_ui_scale);
   int right_margin = 15;
   if(test_bx + g_dyn_W + close_w > cw - right_margin) {
       test_bx = cw - right_margin - g_dyn_W - close_w;
   }
   if(test_bx - menu_w < 10) test_bx = 10 + menu_w;
   
   int labelX = test_bx - menu_w - 5; // Perfect 5px padding flush to UI
   // ----------------------------------------
   
   datetime boxEndTime=0; double dummyP=0; int dummySub=0;
   if(!ChartXYToTimePrice(0,labelX,0,dummySub,boxEndTime,dummyP))
      boxEndTime=TimeCurrent()+PeriodSeconds(_Period)*5;

   datetime insetTime = boxEndTime; 

   for(int i=0; i<PositionsTotal(); i++)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket==0 || PositionGetString(POSITION_SYMBOL)!=_Symbol) continue;

      long   pType  = PositionGetInteger(POSITION_TYPE);
      double entry  = PositionGetDouble(POSITION_PRICE_OPEN);
      double tp     = PositionGetDouble(POSITION_TP);
      double sl     = PositionGetDouble(POSITION_SL);
      double profit = PositionGetDouble(POSITION_PROFIT);
      double lot    = PositionGetDouble(POSITION_VOLUME);
      double curP   = PositionGetDouble(POSITION_PRICE_CURRENT);
      datetime openTime=(datetime)PositionGetInteger(POSITION_TIME);

      ENUM_ORDER_TYPE ot=(pType==POSITION_TYPE_BUY)?ORDER_TYPE_BUY:ORDER_TYPE_SELL;
      bool   isBuy  =(pType==POSITION_TYPE_BUY);
      string sfx    =IntegerToString((int)ticket);
      color  lCol   =isBuy?Color_Buy:Color_Sell;

      int tIdx=0; 
      for(int a=0; a<aCnt; a++) {
         if(aPos[a].tkt==ticket) { tIdx=a+1; break; }
      }
      
      string ord="";
      if(tIdx==2) ord="2nd "; else if(tIdx==3) ord="3rd "; else if(tIdx>3) ord=IntegerToString(tIdx)+"th ";

      color  pCol  = (profit>=0) ? Color_Profit : Color_Loss;
      string pTxt  = ((profit>=0)?"+$":"-$")+DoubleToString(MathAbs(profit),2);

      color eBgCol     = Entry_Solid_Fill ? lCol : Entry_BG_Color; 
      color eBorderCol = lCol;
      color eSideCol   = Entry_Solid_Fill ? clrWhite : lCol;
      color eValCol    = Entry_Solid_Fill ? clrWhite : pCol;
      color eDimCol    = Entry_Solid_Fill ? clrWhite : Label_DimText;
      color eSepCol    = Entry_Solid_Fill ? clrWhite : Sep_Color;

      bool   inProfit =(isBuy ? curP>entry : curP<entry);

      int zBase=10+(i*10);

      bool isRiskFree = false;
      if(sl > 0) {
          double diff = isBuy ? (sl - entry) : (entry - sl);
          if(diff >= -safe_point) isRiskFree = true;
      }

      double risk_dist = (sl>0) ? MathAbs(entry-sl) : 0;
      double rwd_dist  = (tp>0) ? MathAbs(entry-tp)  : 0;
      
      string rr_str;
      if (isRiskFree) rr_str = "INF";
      else if (risk_dist > safe_point * 0.5) rr_str = DoubleToString(rwd_dist / risk_dist, 1);
      else rr_str = "0.0";

      SetLine("E"+sfx,openTime,boxEndTime,entry,lCol,Entry_LineWidth,Entry_Dashed);
      
      string entrySub = "";
      if(ZoneText_Mode==SUB_LABEL && ShowZoneText && tp>0 && sl>0) {
         if (isRiskFree) entrySub = "RR 1 : INF";
         else entrySub = "RR 1 : " + rr_str;
      }
      
      SetLabel(ticket, "E"+sfx,entry,ord+(isBuy?"BUY":"SELL"),DoubleToString(lot,2),pTxt,
               eSideCol,eValCol,eBgCol,eBorderCol,eDimCol,eSepCol,entrySub,c_Zone_Text_Color,inProfit,zBase);

      int c_idx=-1;
      for(int c=0; c<ArraySize(g_ppp_cache); c++) {
         if(g_ppp_cache[c].ticket==ticket) { c_idx=c; break; }
      }
      
      if(c_idx<0) {
         c_idx=ArraySize(g_ppp_cache); ArrayResize(g_ppp_cache,c_idx+1);
         g_ppp_cache[c_idx].ticket=ticket; 
         g_ppp_cache[c_idx].volume=lot;
         g_ppp_cache[c_idx].initial_volume=lot;
         g_ppp_cache[c_idx].sl_price=-1; 
         g_ppp_cache[c_idx].tp_price=-1;
         
         for(int k=0; k<4; k++) {
            string gv_name = PREFIX+"PTP_TK_"+IntegerToString(ticket)+"_"+IntegerToString(k);
            if(GlobalVariableCheck(gv_name)) {
               g_ppp_cache[c_idx].ptp_active[k] = true;
               g_ppp_cache[c_idx].ptp_hit[k] = false;
               g_ppp_cache[c_idx].ptp_price[k] = GlobalVariableGet(gv_name);
            } else {
               g_ppp_cache[c_idx].ptp_active[k] = false;
               g_ppp_cache[c_idx].ptp_hit[k] = false;
               g_ppp_cache[c_idx].ptp_price[k] = 0;
            }
         }
      } else {
         if(lot > g_ppp_cache[c_idx].initial_volume) g_ppp_cache[c_idx].initial_volume = lot;
         if(lot != g_ppp_cache[c_idx].volume) {
            g_ppp_cache[c_idx].tp_price = -1; 
            g_ppp_cache[c_idx].sl_price = -1; 
            g_ppp_cache[c_idx].volume = lot;
         }
      }

      for(int pt=0; pt<4; pt++) {
         if(g_ppp_cache[c_idx].ptp_active[pt]) {
            bool hit = g_ppp_cache[c_idx].ptp_hit[pt];
            double target = g_ppp_cache[c_idx].ptp_price[pt];
            double pct = (pt==0) ? Partial_TP1_Pct : (pt==1) ? Partial_TP2_Pct : (pt==2) ? Partial_TP3_Pct : Partial_TP4_Pct;
            
            SetPTPLine(pt, sfx, target, pct, hit);
         } else {
            string sfx_idx = IntegerToString(pt+1)+"_"+sfx;
            SafeDelete(PREFIX+"PTP_LN_"+sfx_idx);
            SafeDelete(PREFIX+"PTP_LBL_"+sfx_idx);
            SafeDelete(PREFIX+"PTP_VAL_"+sfx_idx);
            SafeDelete(PREFIX+"PTP_DEL_"+sfx_idx);
         }
      }

      if(tp>0)
      {
         double tpM=0;
         if(tp==g_ppp_cache[c_idx].tp_price && lot==g_ppp_cache[c_idx].volume) tpM=g_ppp_cache[c_idx].tp_money;
         else {
            if(MathAbs(tp-entry) < safe_point*0.5) tpM=0; 
            else {
               if(!OrderCalcProfit(ot,_Symbol,lot,entry,tp,tpM)){
                  double ts=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE); double tv=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE);
                  double dist=(ot==ORDER_TYPE_BUY)?(tp-entry):(entry-tp); if(ts>0) tpM=(dist/ts)*tv*lot;
               }
            }
            g_ppp_cache[c_idx].tp_price=tp; g_ppp_cache[c_idx].tp_money=tpM; g_ppp_cache[c_idx].volume=lot;
         }

         double bal = AccountInfoDouble(ACCOUNT_BALANCE);
         double rwd_pct = (bal>0) ? (MathAbs(tpM)/bal)*100.0 : 0;
         
         string rwdTxt = "";
         if (isRiskFree) rwdTxt = "Reward INF  ( " + DoubleToString(rwd_pct, 2) + " % )                    ";
         else rwdTxt = "Reward " + rr_str + "  ( " + DoubleToString(rwd_pct, 2) + " % )                    ";

         if(ZoneText_Mode == ZONE_INSIDE) {
            SafeDelete(PREFIX+"SUB_T"+sfx);
            SetChartText("RWD_"+sfx, insetTime, tp, rwdTxt, c_Zone_Text_Color, ANCHOR_RIGHT_LOWER, zBase);
         } else SafeDelete(PREFIX+"ZTX_RWD_"+sfx);

         SetZone("RWD_"+sfx,openTime,boxEndTime,entry,tp,c_Zone_Reward);
         SetLine("T"+sfx,openTime,boxEndTime,tp,Color_TP,TP_LineWidth,TP_Dashed);
         color tpCol=(tpM>=0)?Color_Profit:Color_Loss;
         string tpSub = (ZoneText_Mode==SUB_LABEL) ? rwdTxt : "";
         
         SetLabel(ticket, "T"+sfx,tp,ord+"TP",DoubleToString(lot,2),((tpM>=0)?"+$":"-$")+DoubleToString(MathAbs(tpM),2),Color_TP,tpCol,
                  Label_BG,Color_TP,Label_DimText,Sep_Color, tpSub,c_Zone_Text_Color,false,zBase);
      }
      else {
         SafeDelete(PREFIX+"ZTX_RWD_"+sfx); SafeDelete(PREFIX+"ZN_RWD_"+sfx); SafeDelete(PREFIX+"LN_T"+sfx);
         SafeDelete(PREFIX+"BX_T"+sfx+"_OUT"); SafeDelete(PREFIX+"BX_T"+sfx+"_IN"); SafeDelete(PREFIX+"SD_T"+sfx); 
         SafeDelete(PREFIX+"S1_T"+sfx); SafeDelete(PREFIX+"LT_T"+sfx); SafeDelete(PREFIX+"S2_T"+sfx);
         SafeDelete(PREFIX+"VL_T"+sfx); SafeDelete(PREFIX+"SUB_T"+sfx); SafeDelete(PREFIX+"BTN_T_"+sfx);
      }

      if(sl>0)
      {
         double slM=0;
         if(sl==g_ppp_cache[c_idx].sl_price && lot==g_ppp_cache[c_idx].volume) slM=g_ppp_cache[c_idx].sl_money;
         else {
            if(MathAbs(sl-entry) < safe_point*0.5) slM=0; 
            else {
               if(!OrderCalcProfit(ot,_Symbol,lot,entry,sl,slM)){
                  double ts=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_SIZE); double tv=SymbolInfoDouble(_Symbol,SYMBOL_TRADE_TICK_VALUE);
                  double dist=(ot==ORDER_TYPE_BUY)?(sl-entry):(entry-sl); if(ts>0) slM=(dist/ts)*tv*lot;
               }
            }
            g_ppp_cache[c_idx].sl_price=sl; g_ppp_cache[c_idx].sl_money=slM; g_ppp_cache[c_idx].volume=lot;
         }

         double bal        = AccountInfoDouble(ACCOUNT_BALANCE);
         double risk_pct   = (bal>0) ? (MathAbs(slM)/bal)*100.0 : 0;

         string rskTxt = "";
         if (isRiskFree) rskTxt = "Risk-Free                    ";
         else rskTxt = "Risk 1  ( " + DoubleToString(risk_pct, 2) + " % )                    ";

         if(ZoneText_Mode == ZONE_INSIDE) {
            SafeDelete(PREFIX+"SUB_S"+sfx);
            SetChartText("RSK_"+sfx, insetTime, sl, rskTxt, c_Zone_Text_Color, ANCHOR_RIGHT_UPPER, zBase);
         } else SafeDelete(PREFIX+"ZTX_RSK_"+sfx);

         SetZone("RSK_"+sfx,openTime,boxEndTime,entry,sl,c_Zone_Risk);
         SetLine("S"+sfx,openTime,boxEndTime,sl,Color_SL,SL_LineWidth,SL_Dashed);
         color slCol=(slM>=0)?Color_Profit:Color_Loss;
         string slSub = (ZoneText_Mode==SUB_LABEL) ? rskTxt : "";
         
         SetLabel(ticket, "S"+sfx,sl,ord+"SL",DoubleToString(lot,2),((slM>=0)?"+$":"-$")+DoubleToString(MathAbs(slM),2),Color_SL,slCol,
                  Label_BG,Color_SL,Label_DimText,Sep_Color, slSub,c_Zone_Text_Color,false,zBase);
      }
      else {
         SafeDelete(PREFIX+"ZTX_RSK_"+sfx); SafeDelete(PREFIX+"ZN_RSK_"+sfx); SafeDelete(PREFIX+"LN_S"+sfx);
         SafeDelete(PREFIX+"BX_S"+sfx+"_OUT"); SafeDelete(PREFIX+"BX_S"+sfx+"_IN"); SafeDelete(PREFIX+"SD_S"+sfx); 
         SafeDelete(PREFIX+"S1_S"+sfx); SafeDelete(PREFIX+"LT_S"+sfx); SafeDelete(PREFIX+"S2_S"+sfx);
         SafeDelete(PREFIX+"VL_S"+sfx); SafeDelete(PREFIX+"SUB_S"+sfx); SafeDelete(PREFIX+"BTN_S_"+sfx);
      }

      if(ZoneText_Mode == ZONE_INSIDE && tp>0 && sl>0 && !isRiskFree) {
         string midTxt = "RR 1 : " + rr_str + "                    "; 
         SetChartText("MID_"+sfx, insetTime, entry, midTxt, c_Zone_Text_Color, ANCHOR_RIGHT_UPPER, zBase);
      } else SafeDelete(PREFIX+"ZTX_MID_"+sfx);

      if(isBuy){
         if(curP>entry){
            if(tp>0) SetZone("PRG_RWD_"+sfx,openTime,boxEndTime,entry,MathMin(curP,tp),c_Zone_Reward_Progress);
            else SafeDelete(PREFIX+"ZN_PRG_RWD_"+sfx);
            SafeDelete(PREFIX+"ZN_PRG_RSK_"+sfx);
         } else if(curP<entry){
            if(sl>0) SetZone("PRG_RSK_"+sfx,openTime,boxEndTime,entry,MathMax(curP,sl),c_Zone_Risk_Progress);
            else SafeDelete(PREFIX+"ZN_PRG_RSK_"+sfx);
            SafeDelete(PREFIX+"ZN_PRG_RWD_"+sfx);
         } else { SafeDelete(PREFIX+"ZN_PRG_RWD_"+sfx); SafeDelete(PREFIX+"ZN_PRG_RSK_"+sfx); }
      } else {
         if(curP<entry){
            if(tp>0) SetZone("PRG_RWD_"+sfx,openTime,boxEndTime,entry,MathMax(curP,tp),c_Zone_Reward_Progress);
            else SafeDelete(PREFIX+"ZN_PRG_RWD_"+sfx);
            SafeDelete(PREFIX+"ZN_PRG_RSK_"+sfx);
         } else if(curP>entry){
            if(sl>0) SetZone("PRG_RSK_"+sfx,openTime,boxEndTime,entry,MathMin(curP,sl),c_Zone_Risk_Progress);
            else SafeDelete(PREFIX+"ZN_PRG_RSK_"+sfx);
            SafeDelete(PREFIX+"ZN_PRG_RWD_"+sfx);
         } else { SafeDelete(PREFIX+"ZN_PRG_RWD_"+sfx); SafeDelete(PREFIX+"ZN_PRG_RSK_"+sfx); }
      }

      color prgLineCol=isBuy?(curP>=entry?Color_TP:Color_SL):(curP<=entry?Color_TP:Color_SL);
      SetLine("C"+sfx,openTime,boxEndTime,curP,prgLineCol,1,true);
   }

   CleanEquityBox();
   g_needs_redraw = true;
}

