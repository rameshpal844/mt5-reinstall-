void OnTimer()
{
   static int    lastPosCount = -1;
   static double lastEquity   = -1;
   static double lastProfit   = 0;
   static double lastCurPrice = 0;
   static double lastSLSum    = -1;
   static double lastTPSum    = -1;

   if(!ChartGetInteger(0,CHART_VISIBLE_BARS)) return;

   int    curPosCount = PositionsTotal();
   double curEquity   = AccountInfoDouble(ACCOUNT_EQUITY);

   if(lastPosCount != -1)
   {
      if(curPosCount < lastPosCount)
      {
         ulong closedTkts[]; int closedCnt=0;
         
         for(int c=0; c<ArraySize(g_ppp_cache); c++){
            if(!PositionSelectByTicket(g_ppp_cache[c].ticket)){
               ArrayResize(closedTkts,closedCnt+1);
               closedTkts[closedCnt++] = g_ppp_cache[c].ticket;
            }
         }
         
         for(int c=0; c<closedCnt; c++){
            for(int k=0; k<4; k++) GlobalVariableDel(PREFIX+"PTP_TK_"+IntegerToString(closedTkts[c])+"_"+IntegerToString(k));
            
            if(HistorySelectByPosition(closedTkts[c])){
               for(int d=HistoryDealsTotal()-1; d>=0; d--){
                  ulong deal = HistoryDealGetTicket(d);
                  if(deal==0) continue;
                  
                  if(HistoryDealGetInteger(deal,DEAL_ENTRY)==DEAL_ENTRY_OUT){
                     long reason = HistoryDealGetInteger(deal,DEAL_REASON);
                     if(reason==DEAL_REASON_TP){ if(Sound_TP_Hit!="") PlaySound(Sound_TP_Hit); }
                     else if(reason==DEAL_REASON_SL){ if(Sound_SL_Hit!="") PlaySound(Sound_SL_Hit); }
                     else {
                        for(int cc=0; cc<ArraySize(g_ppp_cache); cc++){
                           if(g_ppp_cache[cc].ticket == closedTkts[c]){
                              double p = HistoryDealGetDouble(deal,DEAL_PRICE);
                              if(g_ppp_cache[cc].tp_price>0 && MathAbs(p-g_ppp_cache[cc].tp_price)<50*_Point) { if(Sound_TP_Hit!="") PlaySound(Sound_TP_Hit); }
                              else if(g_ppp_cache[cc].sl_price>0 && MathAbs(p-g_ppp_cache[cc].sl_price)<50*_Point) { if(Sound_SL_Hit!="") PlaySound(Sound_SL_Hit); }
                              break;
                           }
                        }
                     }
                     break;
                  }
               }
            }
         }
      }
      else if(curPosCount > lastPosCount)
      {
         if(Sound_Order_Filled!="") PlaySound(Sound_Order_Filled);
      }
   }

   g_cache_cleanup_tick++;
   if(g_cache_cleanup_tick >= 10) { CleanCache(); g_cache_cleanup_tick = 0; }

   double curProfit=0, curPrice=0, curSLSum=0, curTPSum=0;
   for(int i=0; i<curPosCount; i++){
      ulong t = PositionGetTicket(i);
      if(t>0 && PositionGetString(POSITION_SYMBOL)==_Symbol){
         curProfit += PositionGetDouble(POSITION_PROFIT);
         curPrice   = PositionGetDouble(POSITION_PRICE_CURRENT);
         curSLSum  += PositionGetDouble(POSITION_SL);
         curTPSum  += PositionGetDouble(POSITION_TP);
         
         int c_idx = GetCacheIdx(t);
         if(c_idx >= 0) {
            bool isBuy = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY;
            double curVol = PositionGetDouble(POSITION_VOLUME);
            
            for(int pt=0; pt<4; pt++) {
               if(g_ppp_cache[c_idx].ptp_active[pt] && !g_ppp_cache[c_idx].ptp_hit[pt]) {
                  double target = g_ppp_cache[c_idx].ptp_price[pt];
                  if(target > 0) {
                     bool hit = isBuy ? (curPrice >= target) : (curPrice <= target);
                     if(hit) {
                        g_ppp_cache[c_idx].ptp_hit[pt] = true;
                        GlobalVariableDel(PREFIX+"PTP_TK_"+IntegerToString(t)+"_"+IntegerToString(pt)); 
                        
                        double pct = (pt==0) ? Partial_TP1_Pct : (pt==1) ? Partial_TP2_Pct : (pt==2) ? Partial_TP3_Pct : Partial_TP4_Pct;
                        double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
                        double minv = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
                        if(step <= 0) step = 0.01;
                        
                        double init_vol = g_ppp_cache[c_idx].initial_volume;
                        double close_vol = NormalizeDouble(MathFloor((init_vol * (pct / 100.0)) / step) * step, 2);
                        
                        if(close_vol >= minv && curVol >= minv) {
                           if(close_vol >= curVol - minv) trade.PositionClose(t);
                           else trade.PositionClosePartial(t, close_vol);
                           Print("Partial TP", pt+1, " Hit! Closed: ", close_vol, " lots.");
                           if(Sound_TP_Hit != "") PlaySound(Sound_TP_Hit);
                        }
                        
                        if(Move_BE_After_TP1 && pt == 0) {
                           trade.PositionModify(t, NormalizeDouble(PositionGetDouble(POSITION_PRICE_OPEN), _Digits), PositionGetDouble(POSITION_TP));
                           Print("Auto Breakeven Executed.");
                        }
                        
                        g_needs_redraw = true;
                     }
                  }
               }
            }
         }
      }
   }

   bool posChanged  = (curPosCount != lastPosCount);
   bool equityMoved = (MathAbs(curEquity-lastEquity) >= 0.01);
   bool profitMoved = (MathAbs(curProfit-lastProfit) >= 0.01);
   bool priceMoved  = (MathAbs(curPrice-lastCurPrice) >= _Point*10);
   bool sltpMoved   = (MathAbs(curSLSum-lastSLSum) >= _Point) || (MathAbs(curTPSum-lastTPSum) >= _Point);

   bool needsUpdate = posChanged||equityMoved||profitMoved||priceMoved||sltpMoved;
   if(g_force_redraw_ticks>0) { needsUpdate = true; g_force_redraw_ticks--; }
   
   if(!needsUpdate && !g_ptp_dragging) return;

   lastPosCount=curPosCount; lastEquity=curEquity;
   lastProfit=curProfit; lastCurPrice=curPrice;
   lastSLSum=curSLSum; lastTPSum=curTPSum;

   if(!g_ptp_dragging) {
      g_needs_redraw=false;
      RefreshBoxes();
      if(g_needs_redraw) ChartRedraw();
   }
}

void OnChartEvent(const int id,const long &lp,const double &dp,const string &sp)
{
   if(id == CHARTEVENT_CLICK) 
   {
      return;
   }

   if(id==CHARTEVENT_MOUSE_MOVE)
   {
      int mx=(int)lp, my=(int)dp;
      uint state=(uint)StringToInteger(sp);
      bool left_click = (state & 1) != 0;
      int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);

      if(left_click) {
         if(!g_ptp_dragging) {
            for(int c=0; c<ArraySize(g_ppp_cache); c++) {
               for(int pt=0; pt<4; pt++) {
                  if(g_ppp_cache[c].ptp_active[pt] && !g_ppp_cache[c].ptp_hit[pt]) {
                     int l_px, l_py;
                     if(ChartTimePriceToXY(0,0,0, g_ppp_cache[c].ptp_price[pt], l_px, l_py)) {
                        if(MathAbs(my - l_py) <= 10) {
                           if(mx > cw - 35) continue; 
                           
                           g_ptp_dragging = true;
                           g_ptp_drag_tkt = g_ppp_cache[c].ticket;
                           g_ptp_drag_idx = pt;
                           ChartSetInteger(0, CHART_MOUSE_SCROLL, false); 
                           break;
                        }
                     }
                  }
               }
               if(g_ptp_dragging) break;
            }
         } else {
            int dummy_sub; datetime dummy_time; double new_price = 0;
            if(ChartXYToTimePrice(0, mx, my, dummy_sub, dummy_time, new_price)) {
               new_price = NormalizeDouble(new_price, _Digits);
               int c_idx = GetCacheIdx(g_ptp_drag_tkt);
               if(c_idx >= 0) {
                  g_ppp_cache[c_idx].ptp_price[g_ptp_drag_idx] = new_price;
                  string sfx = IntegerToString((int)g_ptp_drag_tkt);
                  
                  string ln_name = PREFIX+"PTP_LN_"+IntegerToString(g_ptp_drag_idx+1)+"_"+sfx;
                  ObjectSetDouble(0, ln_name, OBJPROP_PRICE, new_price);
                  
                  double pct = (g_ptp_drag_idx==0)?Partial_TP1_Pct:(g_ptp_drag_idx==1)?Partial_TP2_Pct:(g_ptp_drag_idx==2)?Partial_TP3_Pct:(g_ptp_drag_idx==3)?Partial_TP4_Pct:25.0;
                  UpdatePTP_Labels(g_ptp_drag_idx, sfx, new_price, pct, false);
                  
                  ChartRedraw(); 
               }
            }
         }
      } else {
         if(g_ptp_dragging) {
            g_ptp_dragging = false;
            ChartSetInteger(0, CHART_MOUSE_SCROLL, true);
            GlobalVariableSet(PREFIX+"PTP_TK_"+IntegerToString(g_ptp_drag_tkt)+"_"+IntegerToString(g_ptp_drag_idx), g_ppp_cache[GetCacheIdx(g_ptp_drag_tkt)].ptp_price[g_ptp_drag_idx]);
            RefreshBoxes();
            ChartRedraw();
         }
      }

      int n = ArraySize(g_drawn_tickets);
      if(n==0) return;
      
      static uint last_mouse_tick=0;
      uint now = GetTickCount();
      if(now-last_mouse_tick <= 250 && !g_ptp_dragging) return;
      last_mouse_tick=now;
      
      bool local_redraw=false;
      string fBold = FontFace + " Bold";
      
      for(int i=0; i<n; i++){
         string ts = g_drawn_tickets[i];
         string objs[2] = {PREFIX+"SUB_T"+ts, PREFIX+"SUB_S"+ts};
         int widths[2] = {140, 200};
         
         for(int j=0; j<2; j++){
            long ox = ObjectGetInteger(0,objs[j],OBJPROP_XDISTANCE);
            if (ox == 0) continue; 
            long oy = ObjectGetInteger(0,objs[j],OBJPROP_YDISTANCE);
            
            bool hover = (mx>=ox && mx<=ox+widths[j] && my>=oy && my<=oy+18);
            string wantFont = hover ? fBold : FontFace;
            
            if(ObjectGetString(0,objs[j],OBJPROP_FONT) != wantFont){
               ObjectSetString(0,objs[j],OBJPROP_FONT,wantFont);
               local_redraw = true;
            }
         }
      }
      if(local_redraw) ChartRedraw();
      return;
   }

   if(id==CHARTEVENT_CHART_CHANGE)
   {
      uint now=GetTickCount();
      if(now-g_last_chart_change_tick < CHART_CHANGE_DEBOUNCE_MS) return;
      g_last_chart_change_tick=now;
      
      int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);
      double pMax=ChartGetDouble(0,CHART_PRICE_MAX);
      double pMin=ChartGetDouble(0,CHART_PRICE_MIN);
      
      if(cw!=g_last_cw || MathAbs(pMax-g_last_pMax)>_Point || MathAbs(pMin-g_last_pMin)>_Point){
         g_last_cw=cw; g_last_pMax=pMax; g_last_pMin=pMin;
         g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw();
      }
      return;
   }

   if(id==CHARTEVENT_OBJECT_DRAG)
   {
      if(StringFind(sp,PREFIX+"LN_T")==0 || StringFind(sp,PREFIX+"LN_S")==0)
      {
         int prefLen = StringLen(PREFIX)+3;
         string typeChar = StringSubstr(sp,prefLen,1);
         ulong ticket = (ulong)StringToInteger(StringSubstr(sp,prefLen+1));
         
         if(PositionSelectByTicket(ticket))
         {
            string sym = PositionGetString(POSITION_SYMBOL);
            int digits = (int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
            
            double p0 = ObjectGetDouble(0,sp,OBJPROP_PRICE,0);
            double p1 = ObjectGetDouble(0,sp,OBJPROP_PRICE,1);
            
            double newP = NormalizeDouble((p0!=PositionGetDouble(POSITION_TP) && p0!=PositionGetDouble(POSITION_SL)) ? p0 : p1, digits);
            
            double sl = PositionGetDouble(POSITION_SL);
            double tp = PositionGetDouble(POSITION_TP);
            
            if(typeChar=="T") tp=newP;
            if(typeChar=="S") sl=newP;
            
            if(sl>0) sl=NormalizeDouble(sl,digits);
            if(tp>0) tp=NormalizeDouble(tp,digits);
            
            g_force_redraw_ticks=4;
            
            if(!trade.PositionModify(ticket,sl,tp)) {
               Print("Drag modify failed! Code: ",trade.ResultRetcode()," | Local: ",GetLastError());
            }
            
            ObjectSetInteger(0, sp, OBJPROP_SELECTED, false);
            g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw();
         }
      }
      return;
   }

   if(id==CHARTEVENT_OBJECT_CLICK)
   {
      if(StringFind(sp, PREFIX+"PTP_DEL_") == 0)
      {
         PlaySound("click.wav");
         string rem = StringSubstr(sp, StringLen(PREFIX+"PTP_DEL_"));
         int u_idx = StringFind(rem, "_");
         if(u_idx > 0) {
            int pt_idx = (int)StringToInteger(StringSubstr(rem, 0, u_idx)) - 1;
            ulong tk = (ulong)StringToInteger(StringSubstr(rem, u_idx+1));
            int c_idx = GetCacheIdx(tk);

            if(c_idx >= 0 && pt_idx >= 0 && pt_idx < 4) {
               g_ppp_cache[c_idx].ptp_active[pt_idx] = false;
               g_ppp_cache[c_idx].ptp_hit[pt_idx] = false;
               GlobalVariableDel(PREFIX+"PTP_TK_"+IntegerToString(tk)+"_"+IntegerToString(pt_idx)); 
               
               string sfx = IntegerToString((int)tk);
               string sfx_idx = IntegerToString(pt_idx+1)+"_"+sfx;
               
               SafeDelete(PREFIX+"PTP_LN_"+sfx_idx);
               SafeDelete(PREFIX+"PTP_LBL_"+sfx_idx);
               SafeDelete(PREFIX+"PTP_VAL_"+sfx_idx);
               SafeDelete(PREFIX+"PTP_DEL_"+sfx_idx);

               g_needs_redraw = false; RefreshBoxes(); ChartRedraw();
            }
         }
         return;
      }

      if(StringFind(sp, PREFIX+"RR_") == 0)
      {
         ObjectSetInteger(0,sp,OBJPROP_STATE,false); 
         
         string rem = StringSubstr(sp, StringLen(PREFIX)+3); 
         int u_idx = StringFind(rem, "_");
         if(u_idx < 0) { return; }
         
         int rr_idx = (int)StringToInteger(StringSubstr(rem, 0, u_idx));
         ulong tk = (ulong)StringToInteger(StringSubstr(rem, u_idx+1));
         
         if(PositionSelectByTicket(tk)) {
            double sl = PositionGetDouble(POSITION_SL);
            double entry = PositionGetDouble(POSITION_PRICE_OPEN);
            long type = PositionGetInteger(POSITION_TYPE);
            
            if(sl == 0 || MathAbs(entry - sl) < _Point) {
               Print("Cannot set RR Target: Please drag and set a Stop Loss first.");
               PlaySound("timeout.wav");
               g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw(); return;
            }
            
            double risk = MathAbs(entry - sl);
            double multiplier = (rr_idx==1) ? RR_Target_1 : (rr_idx==2) ? RR_Target_2 : (rr_idx==3) ? RR_Target_3 : RR_Target_Custom;
            double target_dist = risk * multiplier;
            
            double new_tp = (type == POSITION_TYPE_BUY) ? (entry + target_dist) : (entry - target_dist);
            int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
            new_tp = NormalizeDouble(new_tp, digits);
            
            if(!trade.PositionModify(tk, sl, new_tp)) {
               Print("Broker rejected setting RR TP! Code: ", trade.ResultRetcode());
               PlaySound("timeout.wav");
            } else {
               PlaySound("click.wav");
            }
         }
         
         g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw(); return;
      }

      if(StringFind(sp, PREFIX+"ADDPTP_")==0) 
      {
         ObjectSetInteger(0,sp,OBJPROP_STATE,false); PlaySound("click.wav");
         ulong tk = (ulong)StringToInteger(StringSubstr(sp, StringLen(PREFIX)+7));
         int c_idx = GetCacheIdx(tk);
         
         if(c_idx >= 0 && PositionSelectByTicket(tk)) {
            for(int i=0; i<4; i++) {
               if(!g_ppp_cache[c_idx].ptp_active[i]) {
                  g_ppp_cache[c_idx].ptp_active[i] = true;
                  g_ppp_cache[c_idx].ptp_hit[i] = false;
                  
                  double curPrice = PositionGetDouble(POSITION_PRICE_CURRENT);
                  double entry = PositionGetDouble(POSITION_PRICE_OPEN);
                  double tp = PositionGetDouble(POSITION_TP);
                  double sl = PositionGetDouble(POSITION_SL);
                  bool isBuy = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY;
                  
                  double targetPrice = 0;
                  double dist = 0;
                  
                  if(tp > 0 && MathAbs(tp - curPrice) > 100 * _Point) {
                     dist = MathAbs(tp - curPrice) * 0.15; 
                  } else if(sl > 0 && MathAbs(entry - sl) > 100 * _Point) {
                     dist = MathAbs(entry - sl) * 0.5; 
                  } else {
                     dist = curPrice * 0.0015; 
                  }
                  
                  double offset = dist * (i + 1);
                  targetPrice = isBuy ? (curPrice + offset) : (curPrice - offset);
                  
                  g_ppp_cache[c_idx].ptp_price[i] = NormalizeDouble(targetPrice, _Digits);
                  GlobalVariableSet(PREFIX+"PTP_TK_"+IntegerToString(tk)+"_"+IntegerToString(i), g_ppp_cache[c_idx].ptp_price[i]); 
                  break;
               }
            }
         }
         g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw();
         return;
      }
   
      if(StringFind(sp,PREFIX+"BTN_")==0)
      {
         ObjectSetInteger(0,sp,OBJPROP_STATE,false);
         PlaySound("click.wav");

         int    actionOffset = StringLen(PREFIX)+4;
         int    ticketOffset = actionOffset+2;
         string actionStr    = StringSubstr(sp,actionOffset,1);
         ulong  ticket       = (ulong)StringToInteger(StringSubstr(sp,ticketOffset));

         g_force_redraw_ticks=4;

         if(actionStr=="M"){
            if(g_active_menu_ticket == ticket) {
                g_active_menu_ticket = 0;
                g_active_rr_ticket = 0; 
                g_active_partial_ticket = 0;
            } else {
                g_active_menu_ticket = ticket;
                g_active_rr_ticket = 0; 
                g_active_partial_ticket = 0;
            }
         }
         else if(actionStr=="R"){
            if(g_active_rr_ticket == ticket) {
                g_active_rr_ticket = 0;
            } else {
                g_active_rr_ticket = ticket;
                g_active_partial_ticket = 0; 
            }
         }
         else if(actionStr=="P"){
            if(g_active_partial_ticket == ticket) {
                g_active_partial_ticket = 0;
            } else {
                g_active_partial_ticket = ticket;
                g_active_rr_ticket = 0; 
            }
         }
         else if(actionStr=="B"){
            if(PositionSelectByTicket(ticket)){
               double entry  = PositionGetDouble(POSITION_PRICE_OPEN);
               long   pType2 = PositionGetInteger(POSITION_TYPE);
               string sym    = PositionGetString(POSITION_SYMBOL);
               int    digits = (int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
               double ask    = SymbolInfoDouble(sym,SYMBOL_ASK);
               double bid    = SymbolInfoDouble(sym,SYMBOL_BID);
               double cur2   = (pType2==POSITION_TYPE_BUY) ? bid : ask;
               double stp_lv = SymbolInfoInteger(sym,SYMBOL_TRADE_STOPS_LEVEL)*SymbolInfoDouble(sym,SYMBOL_POINT);
               double tp     = PositionGetDouble(POSITION_TP);
               double sl     = PositionGetDouble(POSITION_SL);
               double new_sl = NormalizeDouble(entry,digits);
               
               if(MathAbs(sl-new_sl) < SymbolInfoDouble(sym,SYMBOL_POINT)*0.5){
                  PlaySound("timeout.wav"); Print("BE Ignored: SL already at Breakeven.");
                  g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw(); return;
               }
               
               bool far_enough = (pType2==POSITION_TYPE_BUY) ? (cur2-new_sl)>=stp_lv : (new_sl-cur2)>=stp_lv;
               if(!far_enough){
                  PlaySound("timeout.wav"); Print("BE Failed: Price too close to entry. Broker needs ",(int)(stp_lv/_Point)," pts distance.");
                  g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw(); return;
               }
               
               ResetLastError();
               if(!trade.PositionModify(ticket,new_sl,tp)){
                  PlaySound("timeout.wav"); Print("BE Rejected! Code: ",trade.ResultRetcode()," | Err: ",GetLastError());
               } else { PlaySound("ok.wav"); }
            }
         }
         else if(actionStr=="E" || actionStr=="C"){
            if(!trade.PositionClose(ticket)) Print("Rejected closing! Code: ",trade.ResultRetcode()," | Local: ",GetLastError());
            g_active_menu_ticket=0; g_active_rr_ticket=0; g_active_partial_ticket=0;
         }
         else if(actionStr=="T"||actionStr=="S"){
            if(PositionSelectByTicket(ticket)){
               string sym=PositionGetString(POSITION_SYMBOL);
               int digits=(int)SymbolInfoInteger(sym,SYMBOL_DIGITS);
               double sl=PositionGetDouble(POSITION_SL);
               double tp=PositionGetDouble(POSITION_TP);
               
               if(actionStr=="T") tp=0;
               if(actionStr=="S") sl=0;
               
               if(sl>0) sl=NormalizeDouble(sl,digits);
               if(tp>0) tp=NormalizeDouble(tp,digits);
               
               if(!trade.PositionModify(ticket,sl,tp)) Print("Rejected modify! Code: ",trade.ResultRetcode()," | Local: ",GetLastError());
            }
         }
         
         g_needs_redraw=false; RefreshBoxes(); if(g_needs_redraw) ChartRedraw(); return;
      }
   }
}
