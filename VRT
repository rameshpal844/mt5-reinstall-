double CalculatePartialProfit(ulong tkt, int c_idx, double price, double pct) {
   if(c_idx < 0 || !PositionSelectByTicket(tkt)) return 0.0;
   
   double entry = PositionGetDouble(POSITION_PRICE_OPEN);
   long type = PositionGetInteger(POSITION_TYPE);
   double step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   if(step <= 0) step = 0.01;
   
   double init_vol = g_ppp_cache[c_idx].initial_volume;
   if(init_vol <= 0) init_vol = PositionGetDouble(POSITION_VOLUME);
   
   double exact_vol = init_vol * (pct / 100.0);
   if(exact_vol <= 0) return 0.0;
   
   double profit = 0.0;
   ENUM_ORDER_TYPE ot = (type == POSITION_TYPE_BUY) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   
   if(OrderCalcProfit(ot, _Symbol, exact_vol, entry, price, profit)) {
       return profit;
   } else {
       double tick_val = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
       double tick_sz = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
       if(tick_sz > 0) {
          double dist = (type == POSITION_TYPE_BUY) ? (price - entry) : (entry - price);
          profit = (dist / tick_sz) * exact_vol * tick_val;
       }
   }
   return profit;
}

void UpdatePTP_Labels(int pt_idx, const string sfx, double price, double pct, bool hit)
{
   int px, py;
   if(!ChartTimePriceToXY(0, 0, iTime(_Symbol, _Period, 0), price, px, py)) return;

   int cw = (int)ChartGetInteger(0, CHART_WIDTH_IN_PIXELS);
   int y = py - 7; 

   string sfx_idx = IntegerToString(pt_idx+1)+"_"+sfx;
   string n_lbl = PREFIX+"PTP_LBL_"+sfx_idx;
   string n_val = PREFIX+"PTP_VAL_"+sfx_idx;
   string n_del = PREFIX+"PTP_DEL_"+sfx_idx;

   color col_lbl = hit ? clrGray : (ChartTheme == THEME_DARK ? clrWhite : clrBlack);
   
   string lbl_str = "TP" + IntegerToString(pt_idx+1);
   if(hit) lbl_str += " ✓";
   else lbl_str += " (" + DoubleToString(pct,0) + "%)";

   double profit = 0.0;
   ulong tkt = (ulong)StringToInteger(sfx);
   int c_idx = GetCacheIdx(tkt);
   profit = CalculatePartialProfit(tkt, c_idx, price, pct);
   
   string val_str = (profit >= 0 ? "+$" : "-$") + DoubleToString(MathAbs(profit), 2);
   color col_val = hit ? clrGray : (profit >= 0 ? C'38,166,91' : clrRed);
   
   int ptp_font = (int)(9 * g_ui_scale);
   if (ptp_font < 7) ptp_font = 7;

   if(ObjectFind(0, n_lbl) < 0) {
      ObjectCreate(0, n_lbl, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, n_lbl, OBJPROP_CORNER, CORNER_RIGHT_UPPER);
      ObjectSetInteger(0, n_lbl, OBJPROP_ANCHOR, ANCHOR_RIGHT_UPPER);
      ObjectSetInteger(0, n_lbl, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, n_lbl, OBJPROP_HIDDEN, true);
      ObjectSetString(0, n_lbl, OBJPROP_FONT, FontFace + " Bold");
   }
   ObjectSetInteger(0, n_lbl, OBJPROP_FONTSIZE, ptp_font);
   ObjectSetInteger(0, n_lbl, OBJPROP_XDISTANCE, (int)(110 * g_ui_scale));
   ObjectSetString(0, n_lbl, OBJPROP_TEXT, lbl_str);
   ObjectSetInteger(0, n_lbl, OBJPROP_COLOR, col_lbl);
   ObjectSetInteger(0, n_lbl, OBJPROP_YDISTANCE, y);

   if(ObjectFind(0, n_val) < 0) {
      ObjectCreate(0, n_val, OBJ_LABEL, 0, 0, 0);
      ObjectSetInteger(0, n_val, OBJPROP_CORNER, CORNER_RIGHT_UPPER);
      ObjectSetInteger(0, n_val, OBJPROP_ANCHOR, ANCHOR_RIGHT_UPPER);
      ObjectSetInteger(0, n_val, OBJPROP_SELECTABLE, false);
      ObjectSetInteger(0, n_val, OBJPROP_HIDDEN, true);
      ObjectSetString(0, n_val, OBJPROP_FONT, FontFace + " Bold");
   }
   ObjectSetInteger(0, n_val, OBJPROP_FONTSIZE, ptp_font);
   ObjectSetInteger(0, n_val, OBJPROP_XDISTANCE, (int)(40 * g_ui_scale));
   ObjectSetString(0, n_val, OBJPROP_TEXT, val_str);
   ObjectSetInteger(0, n_val, OBJPROP_COLOR, col_val);
   ObjectSetInteger(0, n_val, OBJPROP_YDISTANCE, y);

   if(!hit) {
      int btn_size = (int)(18 * g_ui_scale);
      if (btn_size < 14) btn_size = 14;
      
      int del_x = cw - 10 - btn_size;
      int del_y = py - btn_size/2;
      SetBtn(n_del, del_x, del_y, btn_size, btn_size, "X", C'140,140,140', clrWhite, "Delete TP", 100);
      ObjectSetInteger(0, n_del, OBJPROP_HIDDEN, false);
   } else {
      SafeDelete(n_del);
   }
}

