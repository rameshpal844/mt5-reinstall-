void OnTimer()
{
   double thr=Thr();
   if(EnOn()){
      double ne=ObjectGetDouble(0,N_EN,OBJPROP_PRICE,0);
      if(MathAbs(ne-g_en_shd)>thr && g_drag_line != N_EN){
         double d=ne-g_entry; g_entry=ne; g_en_shd=g_entry;
         if(TpOn()){ g_tp+=d; SLP(N_TP,g_tp); g_tp_shd=g_tp; }
         if(SlOn()){ g_sl+=d; SLP(N_SL,g_sl); g_sl_shd=g_sl; }
      }
   }
   if(TpOn() && g_drag_line != N_TP){
      double nt=ObjectGetDouble(0,N_TP,OBJPROP_PRICE,0);
      if(MathAbs(nt-g_tp_shd)>thr){ g_tp=nt; g_tp_shd=g_tp; }
   }
   if(SlOn() && g_drag_line != N_SL){
      double ns=ObjectGetDouble(0,N_SL,OBJPROP_PRICE,0);
      if(MathAbs(ns-g_sl_shd)>thr){ g_sl=ns; g_sl_shd=g_sl; }
   }
   Refresh();
   ChartRedraw();
}

