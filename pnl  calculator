double YtoP(int cx, int cy)
{
   double mn = ChartGetDouble(0, CHART_PRICE_MIN);
   double mx = ChartGetDouble(0, CHART_PRICE_MAX);
   if(ChartGetInteger(0, CHART_SCALEFIX))
   {
      mn = ChartGetDouble(0, CHART_FIXED_MIN);
      mx = ChartGetDouble(0, CHART_FIXED_MAX);
   }
   int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
   if(ch<=0) return (mn+mx)*0.5;
   return mn + (1.0-(double)cy/ch)*(mx-mn);
}
int PtoY(double p)
{
   double mn = ChartGetDouble(0, CHART_PRICE_MIN);
   double mx = ChartGetDouble(0, CHART_PRICE_MAX);
   if(ChartGetInteger(0, CHART_SCALEFIX))
   {
      mn = ChartGetDouble(0, CHART_FIXED_MIN);
      mx = ChartGetDouble(0, CHART_FIXED_MAX);
   }
   int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
   if(mx<=mn) return ch/2;
   return (int)(((mx-p)/(mx-mn))*(double)ch);
}
int CY(int y) { int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS); return MathMax(10,MathMin(y,ch-20)); }

void ClampPanel()
{
   int cw=(int)ChartGetInteger(0,CHART_WIDTH_IN_PIXELS);
   int ch=(int)ChartGetInteger(0,CHART_HEIGHT_IN_PIXELS);
   g_px=MathMax(0,MathMin(g_px,cw-InpPanelW-2));
   g_py=MathMax(0,MathMin(g_py,ch-90));
}

bool HitTog(int mx,int my){ return(mx>=g_px && mx<=g_px+16 && my>=g_py && my<=g_py+18); }

