double PT()  { return SymbolInfoDouble(_Symbol, SYMBOL_POINT); }
double TS()  { return SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE); }
double TV()  { return SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE); }
double CS()  { return SymbolInfoDouble(_Symbol, SYMBOL_TRADE_CONTRACT_SIZE); }

double SafeAsk()
{
   double p = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   if(p > 0.0) return p;
   p = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   if(p > 0.0) return p;
   MqlTick tick;
   if(SymbolInfoTick(_Symbol, tick)) {
       if(tick.ask > 0.0) return tick.ask;
       if(tick.bid > 0.0) return tick.bid;
       if(tick.last > 0.0) return tick.last;
   }
   p = iClose(_Symbol, _Period, 0);
   return p;
}

double PnL(double price_open, double price_close, double lots, bool is_buy)
{
   double ts = TS(), tv = TV(), cs = CS();
   if(ts < 1e-10 || tv < 1e-10) return 0.0;
   
   double dist = MathAbs(price_close - price_open);
   double ticks = dist / ts;
   
   ENUM_SYMBOL_CALC_MODE mode = (ENUM_SYMBOL_CALC_MODE)SymbolInfoInteger(_Symbol, SYMBOL_TRADE_CALC_MODE);
   
   if(mode == SYMBOL_CALC_MODE_FOREX) 
   {
       return ticks * tv * lots;
   } 
   else 
   {
       if(tv < (ts * 5.0) && cs > 1.0) 
       {
           return ticks * tv * cs * lots; 
       } 
       else 
       {
           return ticks * tv * lots;      
       }
   }
}

// Fixed Dynamic distance using a fixed percentage of live price
double DefDist(bool is_tp) { 
   double price = SafeAsk();
   if(price <= 0.0) price = 1.0; 
   return is_tp ? (price * 0.002) : (price * 0.001); 
}

double Thr()            { return PT() * 3.0; }

double SymbolDefaultLot()
{
   string s=_Symbol; StringToUpper(s);
   if(StringFind(s,"XAU")>=0||StringFind(s,"XAG")>=0)             return InpLotXAU;
   if(StringFind(s,"US30")>=0||StringFind(s,"DJ30")>=0||
      StringFind(s,"DOW")>=0||StringFind(s,"USTEC")>=0||
      StringFind(s,"NAS")>=0||StringFind(s,"US500")>=0||
      StringFind(s,"SPX")>=0||StringFind(s,"GER")>=0||
      StringFind(s,"UK100")>=0)                                   return InpLotUS30;
   if(StringFind(s,"ETH")>=0)                                     return InpLotETH;
   if(StringFind(s,"BTC")>=0||StringFind(s,"LTC")>=0||
      StringFind(s,"XRP")>=0||StringFind(s,"BNB")>=0)             return InpLotBTC;
   int d=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);
   if(d==4||d==5) return InpLotFX;
   return InpLotOther;
}

double SymbolLotStep()
{
   string s=_Symbol; StringToUpper(s);
   if(StringFind(s,"XAU")>=0||StringFind(s,"XAG")>=0)             return InpStepXAU;
   if(StringFind(s,"US30")>=0||StringFind(s,"DJ30")>=0||
      StringFind(s,"DOW")>=0||StringFind(s,"USTEC")>=0||
      StringFind(s,"NAS")>=0||StringFind(s,"US500")>=0||
      StringFind(s,"SPX")>=0||StringFind(s,"GER")>=0||
      StringFind(s,"UK100")>=0)                                   return InpStepUS30;
   if(StringFind(s,"ETH")>=0)                                     return InpStepETH;
   if(StringFind(s,"BTC")>=0||StringFind(s,"LTC")>=0||
      StringFind(s,"XRP")>=0||StringFind(s,"BNB")>=0)             return InpStepBTC;
   int d=(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS);
   if(d==4||d==5) return InpStepFX;
   return InpStepOther;
}

