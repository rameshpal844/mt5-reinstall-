void OnChartEvent(const int id,const long &lp,const double &dp,const string &sp)
{
   int mx=(int)lp, my=(int)dp;

   if(id==CHARTEVENT_MOUSE_MOVE)
   {
      bool btn=(StringToInteger(sp)&1)==1;
      bool redrawNeeded = false;

      int ye_hit = EnOn() ? PtoY(g_entry) : -10000;
      int yt_hit = TpOn() ? PtoY(g_tp)    : -10000;
      int ys_hit = SlOn() ? PtoY(g_sl)    : -10000;

      // SYNC HANDSHAKE SIGNAL
      string gvLock = "PNL_LOCK_" + IntegerToString(ChartID());
      int pHeight = g_open ? 38 : 18; 
      bool nearPanel = (mx >= g_px && mx <= g_px + InpPanelW && my >= g_py && my <= g_py + pHeight);
      
      bool nearLine = false;
      if(EnOn() && MathAbs(my - ye_hit) <= InpGrabPixels) nearLine = true;
      if(TpOn() && MathAbs(my - yt_hit) <= InpGrabPixels) nearLine = true;
      if(SlOn() && MathAbs(my - ys_hit) <= InpGrabPixels) nearLine = true;

      if(nearLine || nearPanel || g_drag || g_drag_line != "") {
         GlobalVariableTemp(gvLock);
         GlobalVariableSet(gvLock, 1.0);
      } else {
         if(GlobalVariableCheck(gvLock)) GlobalVariableDel(gvLock);
      }

      // --- MOUSE CLICK DOWN ---
      if(btn && !g_lbtn){
         if(HitTog(mx,my)){ 
            g_drag=true; g_dmov=0; g_dsx=mx; g_dsy=my; g_dox=g_px; g_doy=g_py; 
         }
         else {
            int best_dist = InpGrabPixels + 1;
            if(EnOn() && MathAbs(my - ye_hit) < best_dist) { g_drag_line = N_EN; best_dist = MathAbs(my - ye_hit); }
            if(TpOn() && MathAbs(my - yt_hit) < best_dist) { g_drag_line = N_TP; best_dist = MathAbs(my - yt_hit); }
            if(SlOn() && MathAbs(my - ys_hit) < best_dist) { g_drag_line = N_SL; best_dist = MathAbs(my - ys_hit); }
         }
      }

      // --- DRAGGING PANEL ---
      if(btn && g_drag){
         int ddx=mx-g_dsx, ddy=my-g_dsy;
         g_dmov=MathMax(g_dmov,(int)MathSqrt((double)(ddx*ddx+ddy*ddy)));
         g_px=g_dox+ddx; g_py=g_doy+ddy;
         MoveAll(); redrawNeeded = true;
      }

      // --- DRAGGING A LINE ---
      if(btn && g_drag_line != "") {
         double new_p = YtoP(mx, my);
         
         if(g_drag_line == N_EN) {
            double d = new_p - g_entry;
            g_entry = new_p; g_en_shd = g_entry; SLP(N_EN, g_entry);
            if(TpOn()){ g_tp += d; SLP(N_TP, g_tp); g_tp_shd = g_tp; }
            if(SlOn()){ g_sl += d; SLP(N_SL, g_sl); g_sl_shd = g_sl; }
         }
         else if(g_drag_line == N_TP) { g_tp = new_p; g_tp_shd = g_tp; SLP(N_TP, g_tp); }
         else if(g_drag_line == N_SL) { g_sl = new_p; g_sl_shd = g_sl; SLP(N_SL, g_sl); }
         
         Refresh(); redrawNeeded = true;
      }

      // --- MOUSE RELEASE ---
      if(!btn){
         if(g_drag){
            if(g_dmov<6){
               g_open=!g_open;
               MoveAll();
               UpdateBtns(); redrawNeeded = true;
            }
            g_drag=false;
         }
         g_drag_line = ""; 
      }
      
      if(redrawNeeded) ChartRedraw();
      g_lbtn=btn; return;
   }

   if(id==CHARTEVENT_CLICK)
   {
      double price=YtoP(mx,my);
      double ref=EnOn()?g_entry:SafeAsk();

      if(g_en_mode==1){
         g_entry=price; g_en_shd=g_entry;
         SLP(N_EN,g_entry);
         ShowLine(N_EN,L_EN,InpCEntry,true);
         g_en_mode=2;
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }
      if(g_tp_mode==1){
         if(g_buy && price<ref) price=ref+MathAbs(price-ref);
         if(!g_buy && price>ref) price=ref-MathAbs(price-ref);
         g_tp=price; g_tp_shd=g_tp;
         SLP(N_TP,g_tp);
         ShowLine(N_TP,L_TP,InpCTP,true);
         g_tp_mode=2;
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }
      if(g_sl_mode==1){
         if(g_buy && price>ref) price=ref-MathAbs(price-ref);
         if(!g_buy && price<ref) price=ref+MathAbs(price-ref);
         g_sl=price; g_sl_shd=g_sl;
         SLP(N_SL,g_sl);
         ShowLine(N_SL,L_SL,InpCSL,true);
         g_sl_mode=2;
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }
   }

   if(id==CHARTEVENT_OBJECT_CLICK)
   {
      if(sp==C_EN){
         ObjectSetInteger(0,C_EN,OBJPROP_STATE,false);
         ShowLine(N_EN,L_EN,InpCEntry,false);
         g_en_mode=0; 
         ObjectSetInteger(0,C_EN,OBJPROP_YDISTANCE, -5000); 
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }
      if(sp==C_TP){
         ObjectSetInteger(0,C_TP,OBJPROP_STATE,false);
         ShowLine(N_TP,L_TP,InpCTP,false);
         g_tp_mode=0; 
         ObjectSetInteger(0,C_TP,OBJPROP_YDISTANCE, -5000); 
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }
      if(sp==C_SL){
         ObjectSetInteger(0,C_SL,OBJPROP_STATE,false);
         ShowLine(N_SL,L_SL,InpCSL,false);
         g_sl_mode=0; 
         ObjectSetInteger(0,C_SL,OBJPROP_YDISTANCE, -5000); 
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }

      if(sp==G_TOG){ ObjectSetInteger(0,G_TOG,OBJPROP_STATE,false); return; }

      if(sp==G_BEN){
         ObjectSetInteger(0,G_BEN,OBJPROP_STATE,false);
         if(g_en_mode==0){
            g_entry=SafeAsk(); SLP(N_EN,g_entry); g_en_shd=g_entry;
            ShowLine(N_EN,L_EN,InpCEntry,true);
            g_en_mode=1;
         } else {
            ShowLine(N_EN,L_EN,InpCEntry,false);
            g_en_mode=0;
         }
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }

      if(sp==G_BTP){
         ObjectSetInteger(0,G_BTP,OBJPROP_STATE,false);
         if(g_tp_mode==0){
            double ref=EnOn()?g_entry:SafeAsk();
            g_tp=ref+(g_buy?DefDist(true):-DefDist(true));
            SLP(N_TP,g_tp); g_tp_shd=g_tp;
            ShowLine(N_TP,L_TP,InpCTP,true);
            g_tp_mode=1;
         } else {
            ShowLine(N_TP,L_TP,InpCTP,false);
            g_tp_mode=0;
         }
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }

      if(sp==G_BSL){
         ObjectSetInteger(0,G_BSL,OBJPROP_STATE,false);
         if(g_sl_mode==0){
            double ref=EnOn()?g_entry:SafeAsk();
            g_sl=ref+(g_buy?-DefDist(false):DefDist(false));
            SLP(N_SL,g_sl); g_sl_shd=g_sl;
            ShowLine(N_SL,L_SL,InpCSL,true);
            g_sl_mode=1;
         } else {
            ShowLine(N_SL,L_SL,InpCSL,false);
            g_sl_mode=0;
         }
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }

      if(sp==G_LIV){
         ObjectSetInteger(0,G_LIV,OBJPROP_STATE,false);
         if(EnOn()){ g_entry=SafeAsk(); SLP(N_EN,g_entry); g_en_shd=g_entry; }
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }

      if(sp==G_SID){
         ObjectSetInteger(0,G_SID,OBJPROP_STATE,false);
         g_buy=!g_buy;
         double ref=EnOn()?g_entry:SafeAsk();
         if(TpOn()){ double d=MathAbs(g_tp-ref); g_tp=g_buy?ref+d:ref-d; SLP(N_TP,g_tp); g_tp_shd=g_tp; }
         if(SlOn()){ double d=MathAbs(g_sl-ref); g_sl=g_buy?ref-d:ref+d; SLP(N_SL,g_sl); g_sl_shd=g_sl; }
         UpdateBtns(); Refresh(); ChartRedraw(); return;
      }

      if(sp==G_PLS){ g_lot=NormalizeDouble(MathMin(g_lot+SymbolLotStep(),InpLotMax),3); g_lotstr=DoubleToString(g_lot,3); ObjectSetInteger(0,G_PLS,OBJPROP_STATE,false); Refresh(); ChartRedraw(); return; }
      if(sp==G_MIN){ g_lot=NormalizeDouble(MathMax(g_lot-SymbolLotStep(),InpLotMin),3); g_lotstr=DoubleToString(g_lot,3); ObjectSetInteger(0,G_MIN,OBJPROP_STATE,false); Refresh(); ChartRedraw(); return; }
   }

   if(id==CHARTEVENT_OBJECT_ENDEDIT && sp==G_EDT){
      double v=StringToDouble(ObjectGetString(0,G_EDT,OBJPROP_TEXT));
      if(v>=InpLotMin && v<=InpLotMax) g_lot=NormalizeDouble(v,3);
      g_lotstr=DoubleToString(g_lot,3);
      ObjectSetString(0,G_EDT,OBJPROP_TEXT,g_lotstr);
      Refresh(); ChartRedraw();
   }
}
