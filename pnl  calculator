void Refresh()
{
   double ask = SafeAsk();
   double ref = EnOn() ? g_entry : ask;

   double tp_pnl = TpOn() ? PnL(ref, g_tp, g_lot, g_buy) : 0;
   double sl_pnl = SlOn() ? PnL(ref, g_sl, g_lot, g_buy) : 0;
   
   double pt = PT();
   int tp_pts = TpOn()&&pt>0 ? (int)MathRound(MathAbs(g_tp-ref)/pt) : 0;
   int sl_pts = SlOn()&&pt>0 ? (int)MathRound(MathAbs(g_sl-ref)/pt) : 0;

   int lx=InpLblOffX, mg=InpLblGap;
   int bx=5; 
   int bh_half = 10; 
   
   int ye_line=EnOn()?PtoY(g_entry):0;
   int yt_line=TpOn()?PtoY(g_tp):0;
   int ys_line=SlOn()?PtoY(g_sl):0;

   if(EnOn()){
      int yp_lbl = CY(ye_line+4);
      ObjectSetInteger(0,L_EN,OBJPROP_XDISTANCE,lx);
      ObjectSetInteger(0,L_EN,OBJPROP_YDISTANCE,yp_lbl);
      ObjectSetString(0, L_EN,OBJPROP_TEXT,
         g_en_mode==1?"ENTRY — click chart":
         StringFormat("ENTRY  %.3f  %s",g_lot,g_buy?"BUY":"SELL"));
         
      ObjectSetInteger(0,C_EN,OBJPROP_XDISTANCE, bx);
      ObjectSetInteger(0,C_EN,OBJPROP_YDISTANCE, CY(ye_line) - bh_half); 
   } else {
      ObjectSetInteger(0,C_EN,OBJPROP_YDISTANCE, -5000); 
   }
   
   if(TpOn()){
      int yp_lbl = CY(yt_line+4); if(EnOn()&&MathAbs(yp_lbl-CY(ye_line+4))<mg) yp_lbl=CY(yt_line-mg);
      ObjectSetInteger(0,L_TP,OBJPROP_XDISTANCE,lx);
      ObjectSetInteger(0,L_TP,OBJPROP_YDISTANCE,yp_lbl);
      ObjectSetString(0, L_TP,OBJPROP_TEXT,
         g_tp_mode==1?"TP — click chart":
         InpShowPts?StringFormat("TP  +$%.2f  (%d pts)",tp_pnl,tp_pts):StringFormat("TP  +$%.2f",tp_pnl));
         
      ObjectSetInteger(0,C_TP,OBJPROP_XDISTANCE, bx);
      ObjectSetInteger(0,C_TP,OBJPROP_YDISTANCE, CY(yt_line) - bh_half);
   } else {
      ObjectSetInteger(0,C_TP,OBJPROP_YDISTANCE, -5000); 
   }
   
   if(SlOn()){
      int yp_lbl = CY(ys_line+4); if(EnOn()&&MathAbs(yp_lbl-CY(ye_line+4))<mg) yp_lbl=CY(ys_line+mg);
      ObjectSetInteger(0,L_SL,OBJPROP_XDISTANCE,lx);
      ObjectSetInteger(0,L_SL,OBJPROP_YDISTANCE,yp_lbl);
      ObjectSetString(0, L_SL,OBJPROP_TEXT,
         g_sl_mode==1?"SL — click chart":
         InpShowPts?StringFormat("SL  -$%.2f  (%d pts)",sl_pnl,sl_pts):StringFormat("SL  -$%.2f",sl_pnl));
         
      ObjectSetInteger(0,C_SL,OBJPROP_XDISTANCE, bx);
      ObjectSetInteger(0,C_SL,OBJPROP_YDISTANCE, CY(ys_line) - bh_half); 
   } else {
      ObjectSetInteger(0,C_SL,OBJPROP_YDISTANCE, -5000); 
   }
   
   ObjectSetString(0,G_EDT,OBJPROP_TEXT,g_lotstr);
}

