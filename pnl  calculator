int OnInit()
{
   g_px=InpPanelX; g_py=InpPanelY; g_buy=InpBuyMode;
   g_lot=NormalizeDouble(SymbolDefaultLot(),3);
   g_lotstr=DoubleToString(g_lot,3);
   
   double ask = SafeAsk();
   
   string gvLock = "PNL_LOCK_" + IntegerToString(ChartID());
   if(GlobalVariableCheck(gvLock)) GlobalVariableDel(gvLock);
   
   string pre = "PNL_" + _Symbol;
   if(GlobalVariableCheck(pre+"_SL")) {
      g_sl      = GlobalVariableGet(pre+"_SL");
      g_tp      = GlobalVariableGet(pre+"_TP");
      g_entry   = GlobalVariableGet(pre+"_EN");
      g_buy     = (GlobalVariableGet(pre+"_BUY") > 0.0);
      g_sl_mode = (int)GlobalVariableGet(pre+"_MSL");
      g_tp_mode = (int)GlobalVariableGet(pre+"_MTP");
      g_en_mode = (int)GlobalVariableGet(pre+"_MEN");
      
      GlobalVariableDel(pre+"_SL"); GlobalVariableDel(pre+"_TP"); GlobalVariableDel(pre+"_EN");
      GlobalVariableDel(pre+"_BUY"); GlobalVariableDel(pre+"_MSL"); GlobalVariableDel(pre+"_MTP"); GlobalVariableDel(pre+"_MEN");
   } else {
      g_entry = ask;
      g_tp = ask + (g_buy ? DefDist(true) : -DefDist(true));
      g_sl = ask + (g_buy ? -DefDist(false) : DefDist(false));
      g_sl_mode = 2;
      g_tp_mode = 0;
      g_en_mode = 0;
   }
   
   g_tp_shd=g_tp; g_sl_shd=g_sl; g_en_shd=g_entry;

   MkHLine(N_EN, g_entry, clrNONE, InpStyleEntry, InpLineWidth);
   MkHLine(N_TP, g_tp, clrNONE, InpStyleTP,  InpLineWidth);
   MkHLine(N_SL, g_sl, clrNONE, InpStyleSL,  InpLineWidth);
   
   MkLblChart(L_EN,clrNONE);
   MkLblChart(L_TP,clrNONE);
   MkLblChart(L_SL,clrNONE);

   MkCancelBtn(C_EN, clrWhite, InpCEntry);
   MkCancelBtn(C_TP, clrWhite, InpCTP);
   MkCancelBtn(C_SL, clrWhite, InpCSL);
   
   ShowLine(N_SL, L_SL, InpCSL, SlOn());
   ShowLine(N_TP, L_TP, InpCTP, TpOn());
   ShowLine(N_EN, L_EN, InpCEntry, EnOn());

   ChartSetInteger(0,CHART_EVENT_MOUSE_MOVE,true);
   
   BuildUI();
   UpdateBtns();
   Refresh();
   MoveAll();
   
   EventSetMillisecondTimer(250);
   ChartRedraw();
   return INIT_SUCCEEDED;
}

void OnDeinit(const int r)
{
   EventKillTimer();
   ChartSetInteger(0,CHART_EVENT_MOUSE_MOVE,false);
   
   string pre = "PNL_" + _Symbol;
   string gvLock = "PNL_LOCK_" + IntegerToString(ChartID());
   if(GlobalVariableCheck(gvLock)) GlobalVariableDel(gvLock);
   
   if(r == REASON_CHARTCHANGE) {
       GlobalVariableTemp(pre+"_SL"); GlobalVariableSet(pre+"_SL", g_sl);
       GlobalVariableTemp(pre+"_TP"); GlobalVariableSet(pre+"_TP", g_tp);
       GlobalVariableTemp(pre+"_EN"); GlobalVariableSet(pre+"_EN", g_entry);
       GlobalVariableTemp(pre+"_BUY"); GlobalVariableSet(pre+"_BUY", g_buy?1.0:0.0);
       GlobalVariableTemp(pre+"_MSL"); GlobalVariableSet(pre+"_MSL", g_sl_mode);
       GlobalVariableTemp(pre+"_MTP"); GlobalVariableSet(pre+"_MTP", g_tp_mode);
       GlobalVariableTemp(pre+"_MEN"); GlobalVariableSet(pre+"_MEN", g_en_mode);
   } else {
       if(GlobalVariableCheck(pre+"_SL")) GlobalVariableDel(pre+"_SL");
       if(GlobalVariableCheck(pre+"_TP")) GlobalVariableDel(pre+"_TP");
       if(GlobalVariableCheck(pre+"_EN")) GlobalVariableDel(pre+"_EN");
       if(GlobalVariableCheck(pre+"_BUY")) GlobalVariableDel(pre+"_BUY");
       if(GlobalVariableCheck(pre+"_MSL")) GlobalVariableDel(pre+"_MSL");
       if(GlobalVariableCheck(pre+"_MTP")) GlobalVariableDel(pre+"_MTP");
       if(GlobalVariableCheck(pre+"_MEN")) GlobalVariableDel(pre+"_MEN");
   }
   
   string a[]={N_EN,N_TP,N_SL,L_EN,L_TP,L_SL, C_EN, C_TP, C_SL,
               G_TOG,G_BG1,G_SID,G_MIN,G_EDT,G_PLS,G_BEN,G_BTP,G_BSL,G_LIV};
   for(int i=0;i<ArraySize(a);i++) ObjectDelete(0,a[i]);
   ChartRedraw();
}

